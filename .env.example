# Supabase (Frontend) - required in the browser
# Example: https://YOUR-PROJECT.ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server) - only if you need service-level access (not used in this app)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection for Drizzle and seeding
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For local Supabase: postgres://postgres:postgres@localhost:5432/postgres
DB_CONNECTION_STRING=