{
  "$comment": "Allowlist for scripts/db/content-sync.mjs. ONLY training content (curriculum, courses, enablers, use cases, quizzes) is ever synchronised between public_preview and public. Never user data: no profiles, organizations, submissions, progress, certificates, evaluations, notifications, hai_embeddings. The order follows the foreign keys (parents first). key = columns that identify a row across both schemas (stable keys); until the stable code columns exist, the keys marked status=provisional are natural keys. columns = the explicit list of columns that are copied; a column that is not listed is never copied (is_indexed_by_hai is deliberately missing). A listed column that is a foreign key to a user table (profiles, organizations, auth) needs a remap rule, otherwise the sync aborts. remap translates a foreign key column through the key of the parent table (the ids differ between the schemas). lookups = tables that are only READ to translate ids (matched by email or slug), their rows are never copied. update: always | newer | never, only used with --update configured (the release run always uses --update never, i.e. insert only). optional=true: the table may be missing in one schema (created by a migration of another branch), it is then skipped with a note. catalogScope = how a row is assigned to a training catalog for a run limited to one occupation (--catalog <CODE>): self (the catalog table, column = code), column (the table has the catalog column) or parents (the row belongs to the catalog of a parent row, listed as column + table, nested up to a table with the column; any parent counts). catalogKey = the key of such a run (with the stable code); without --catalog it is ignored and key is used. A table without catalogScope is skipped in a run with --catalog. withheldFromPublic = columns that carry the activation state (is_active, is_published, activated_at): they are never written into public (Production), so a new row starts with the column default (inactive, not published) and an existing row keeps its state; towards public_preview they are copied. The learning fields and their mappings are NOT the views lernfelder and lernfeld_mappings (compatibility views since 20261024000500, an insert into them would write twice) but the tables training_catalog_learning_fields and training_catalog_content_mappings.",
  "version": 1,
  "lookups": {
    "profiles": {
      "matchOn": ["email"],
      "pk": "id"
    },
    "organizations": {
      "matchOn": ["slug"],
      "pk": "id"
    }
  },
  "tables": [
    {
      "name": "training_catalogs",
      "key": ["code"],
      "columns": [
        "code",
        "title",
        "description",
        "duration_years",
        "created_at",
        "updated_at",
        "occupation_code",
        "regulation_version",
        "elective_pick_count",
        "settings"
      ],
      "optional": true,
      "status": "provisional",
      "note": "Insert only (update never): the sync never activates or changes a catalog. is_active is not copied, so a catalog that is missing in the target is inserted inactive (the default) and the owner switches it on. The rows are created by the catalog migration in both schemas.",
      "update": "never",
      "catalogScope": {
        "self": "code"
      }
    },
    {
      "name": "training_components",
      "key": ["code"],
      "columns": [
        "code",
        "title",
        "description",
        "total_weeks",
        "total_hours",
        "training_year",
        "order_index",
        "training_catalog_id",
        "created_at",
        "phase",
        "kind"
      ],
      "status": "provisional",
      "note": "The unique constraint is (training_catalog_id, code). The key stays [code] for a run without --catalog (unchanged, unique in Production); a run with --catalog uses catalogKey.",
      "remap": {
        "training_catalog_id": {
          "table": "training_catalogs",
          "onMissing": "skip"
        }
      },
      "catalogKey": ["training_catalog_id", "code"],
      "catalogScope": {
        "column": "training_catalog_id"
      }
    },
    {
      "name": "training_use_cases",
      "key": ["component_id", "letter"],
      "columns": [
        "component_id",
        "letter",
        "description",
        "planned_hours",
        "order_index",
        "created_at"
      ],
      "status": "provisional",
      "remap": {
        "component_id": {
          "table": "training_components",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "component_id",
            "table": "training_components"
          }
        ]
      }
    },
    {
      "name": "courses",
      "key": ["title", "year", "chapter"],
      "columns": [
        "title",
        "description",
        "year",
        "chapter",
        "exam_part",
        "lernfelder",
        "created_by_id",
        "training_catalog_id",
        "is_active",
        "is_published",
        "created_at",
        "updated_at",
        "code",
        "training_component_id"
      ],
      "withheldFromPublic": ["is_active", "is_published"],
      "status": "provisional",
      "note": "The key stays the natural key for a run without --catalog (FIAE courses have no code). A run with --catalog uses the stable code per catalog.",
      "remap": {
        "created_by_id": {
          "table": "profiles",
          "onMissing": "owner"
        },
        "training_catalog_id": {
          "table": "training_catalogs",
          "onMissing": "skip"
        },
        "training_component_id": {
          "table": "training_components",
          "onMissing": "skip"
        }
      },
      "catalogKey": ["training_catalog_id", "code"],
      "catalogScope": {
        "column": "training_catalog_id"
      }
    },
    {
      "name": "enablers",
      "key": ["course_id", "title"],
      "columns": [
        "course_id",
        "title",
        "order_index",
        "description_text",
        "ppt_url",
        "video_url",
        "scenario_pdf_url",
        "duration_value",
        "duration_unit",
        "is_active",
        "activated_at",
        "created_at",
        "updated_at",
        "code"
      ],
      "withheldFromPublic": ["is_active", "activated_at"],
      "status": "provisional",
      "remap": {
        "course_id": {
          "table": "courses",
          "onMissing": "skip"
        }
      },
      "catalogKey": ["course_id", "code"],
      "catalogScope": {
        "parents": [
          {
            "column": "course_id",
            "table": "courses"
          }
        ]
      }
    },
    {
      "name": "use_cases",
      "key": ["course_id", "title"],
      "columns": [
        "course_id",
        "title",
        "description_text",
        "order_index",
        "duration_value",
        "duration_unit",
        "is_active",
        "activated_at",
        "year",
        "training_stage",
        "lernfelder",
        "created_at",
        "updated_at",
        "code",
        "enabler_id"
      ],
      "withheldFromPublic": ["is_active", "activated_at"],
      "status": "provisional",
      "remap": {
        "course_id": {
          "table": "courses",
          "onMissing": "skip"
        },
        "enabler_id": {
          "table": "enablers",
          "onMissing": "skip"
        }
      },
      "catalogKey": ["course_id", "code"],
      "catalogScope": {
        "parents": [
          {
            "column": "course_id",
            "table": "courses"
          }
        ]
      },
      "note": "enabler_id is the 1:1 link to the enabler of the same course; it is translated through the key of the enabler (the ids differ between the schemas). training_catalog_id of enablers and use cases is derived from the course by a database trigger and is not copied."
    },
    {
      "name": "content_documents",
      "key": [
        "enabler_id",
        "use_case_id",
        "course_id",
        "title",
        "file_name",
        "document_type"
      ],
      "columns": [
        "enabler_id",
        "use_case_id",
        "course_id",
        "organization_id",
        "title",
        "description",
        "document_type",
        "visibility",
        "file_name",
        "file_size",
        "mime_type",
        "storage_url",
        "storage_path",
        "page_count",
        "order_index",
        "uploaded_by_id",
        "created_at",
        "updated_at"
      ],
      "status": "provisional",
      "note": "Metadata rows only (no file bytes, storage objects are shared). is_indexed_by_hai is not copied, hai_embeddings is never synchronised. Files uploaded from Preview live under the storage prefix preview/ and keep that path.",
      "remap": {
        "enabler_id": {
          "table": "enablers",
          "onMissing": "skip"
        },
        "use_case_id": {
          "table": "use_cases",
          "onMissing": "skip"
        },
        "course_id": {
          "table": "courses",
          "onMissing": "skip"
        },
        "organization_id": {
          "table": "organizations",
          "onMissing": "null"
        },
        "uploaded_by_id": {
          "table": "profiles",
          "onMissing": "null"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "enabler_id",
            "table": "enablers"
          },
          {
            "column": "use_case_id",
            "table": "use_cases"
          },
          {
            "column": "course_id",
            "table": "courses"
          }
        ]
      }
    },
    {
      "name": "quizzes",
      "key": ["title", "quiz_type", "created_at"],
      "columns": [
        "title",
        "quiz_type",
        "created_by_id",
        "is_active",
        "created_at",
        "updated_at",
        "code",
        "training_catalog_id",
        "training_component_id"
      ],
      "withheldFromPublic": ["is_active"],
      "status": "provisional",
      "remap": {
        "created_by_id": {
          "table": "profiles",
          "onMissing": "owner"
        },
        "training_catalog_id": {
          "table": "training_catalogs",
          "onMissing": "skip"
        },
        "training_component_id": {
          "table": "training_components",
          "onMissing": "skip"
        }
      },
      "catalogKey": ["training_catalog_id", "code"],
      "catalogScope": {
        "column": "training_catalog_id"
      }
    },
    {
      "name": "enabler_quizzes",
      "key": ["enabler_id"],
      "columns": ["enabler_id", "quiz_id"],
      "status": "provisional",
      "remap": {
        "enabler_id": {
          "table": "enablers",
          "onMissing": "skip"
        },
        "quiz_id": {
          "table": "quizzes",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "enabler_id",
            "table": "enablers"
          }
        ]
      }
    },
    {
      "name": "enabler_quiz_links",
      "key": ["enabler_id", "difficulty"],
      "columns": ["enabler_id", "quiz_id", "difficulty"],
      "status": "provisional",
      "remap": {
        "enabler_id": {
          "table": "enablers",
          "onMissing": "skip"
        },
        "quiz_id": {
          "table": "quizzes",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "enabler_id",
            "table": "enablers"
          }
        ]
      }
    },
    {
      "name": "questions",
      "key": ["quiz_id", "order_index"],
      "columns": [
        "quiz_id",
        "question_text",
        "question_type",
        "expected_answer",
        "order_index"
      ],
      "status": "provisional",
      "remap": {
        "quiz_id": {
          "table": "quizzes",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "quiz_id",
            "table": "quizzes"
          }
        ]
      }
    },
    {
      "name": "options",
      "key": ["question_id", "option_text", "is_correct"],
      "columns": [
        "question_id",
        "option_text",
        "is_correct",
        "explanation",
        "order_index"
      ],
      "status": "provisional",
      "remap": {
        "question_id": {
          "table": "questions",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "question_id",
            "table": "questions"
          }
        ]
      }
    },
    {
      "name": "training_catalog_learning_fields",
      "key": ["training_catalog_id", "code"],
      "columns": [
        "training_catalog_id",
        "code",
        "title",
        "description",
        "training_year",
        "hours_budget",
        "order_index",
        "created_at",
        "updated_at"
      ],
      "optional": true,
      "status": "provisional",
      "remap": {
        "training_catalog_id": {
          "table": "training_catalogs",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "column": "training_catalog_id"
      }
    },
    {
      "name": "training_catalog_content_mappings",
      "key": ["learning_field_id", "enabler_id", "use_case_id"],
      "columns": [
        "learning_field_id",
        "enabler_id",
        "use_case_id",
        "created_at"
      ],
      "optional": true,
      "status": "provisional",
      "remap": {
        "learning_field_id": {
          "table": "training_catalog_learning_fields",
          "onMissing": "skip"
        },
        "enabler_id": {
          "table": "enablers",
          "onMissing": "skip"
        },
        "use_case_id": {
          "table": "use_cases",
          "onMissing": "skip"
        }
      },
      "catalogScope": {
        "parents": [
          {
            "column": "learning_field_id",
            "table": "training_catalog_learning_fields"
          }
        ]
      }
    }
  ]
}
